{
  "name": "ridex",
  "private": true,
  "version": "0.1.0",
  "description": "Ride-hailing mini-platform — Database Application & Design group project",
  "workspaces": [
    "apps/*",
    "services/*",
    "libs/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "eslint \"{apps,services,libs}/**/src/**/*.{ts,tsx}\" \"{apps,services,libs}/**/test/**/*.ts\"",
    "lint:fix": "pnpm lint --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,css,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,css,yml,yaml}\"",
    "compose:up": "docker compose up -d --build",
    "compose:down": "docker compose down",
    "db:migrate": "docker compose exec api node dist/scripts/migrate.js",
    "db:seed": "docker compose exec api node dist/scripts/seed.js",
    "db:setup": "pnpm db:migrate && pnpm db:seed",
    "bootstrap": "pnpm compose:up && pnpm db:setup"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "@typescript-eslint/parser": "^7.7.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "prettier": "^3.2.5"
  }
}
