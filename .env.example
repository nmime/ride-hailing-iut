# --- Postgres ---
POSTGRES_USER=ridex
POSTGRES_PASSWORD=
POSTGRES_DB=ridex
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Redpanda / Kafka ---
KAFKA_BROKERS=redpanda:9092
KAFKA_CLIENT_ID=ridex
TOPIC_DRIVER_LOCATION=driver.location.v1
TOPIC_TRIP_EVENTS=trip.events.v1

# --- API ---
API_PORT=3000
API_HOST=0.0.0.0
JWT_SECRET=
JWT_EXPIRES_IN=24h
RIDEX_SEED_PASSWORD=
LOG_LEVEL=info

# --- WebSocket gateway ---
WS_PORT=3100
WS_CORS_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:5173

# --- Matcher ---
# Comma-separated stable IDs used to seed the consistent-hash ring. Match
# the docker-compose `deploy.replicas` count. Each replica is also given
# a HOSTNAME by Docker; the ring uses HOSTNAME to identify "self".
MATCHER_REPLICA_IDS=matcher-0,matcher-1
MATCHER_RING_VNODES=128

# --- Ingestor ---
INGESTOR_PORT=3200
INGESTOR_HOST=0.0.0.0

# --- DB scripts (paths inside the api container; bind-mounted from ./db) ---
MIGRATIONS_DIR=/app/db/migrations
SEED_PATH=/app/db/seed/seed.sql

# --- Smoke test seed identities ---
RIDEX_SMOKE_RIDER_PHONE=+998901111111
RIDEX_SMOKE_DRIVER_PHONE=+998903333333
RIDEX_SMOKE_ADMIN_PHONE=+998900000000
RIDEX_SMOKE_DRIVER_ID=00000000-0000-0000-0000-00000000e001

# --- Frontend ---
VITE_API_BASE=/api
VITE_WS_BASE=/ws
VITE_INGEST_BASE=/ingest
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_PROVIDER=auto
VITE_YANDEX_MAPS_API_KEY=
VITE_YANDEX_MAPS_LANG=en_US

# --- Rate limiter (apps/api uses libs/ratelimiter token-bucket) ---
# Auth bucket is keyed by IP so brute-force `/auth/login` is throttled
# even before a JWT is issued. User bucket is keyed by sub.
RATELIMIT_AUTH_BURST=10
RATELIMIT_AUTH_PER_SECOND=1
RATELIMIT_USER_BURST=60
RATELIMIT_USER_PER_SECOND=20
TRIP_EVENT_OUTBOX_INTERVAL_MS=5000

# --- Surge worker ---
SURGE_T_LOW=0.5
SURGE_T_HIGH=1.5
SURGE_M_MAX=3.0
SURGE_WINDOW_MS=60000
SURGE_FLUSH_MS=30000

# --- Cron worker ---
EXPORTS_DIR=/var/exports
CRON_NIGHTLY=0 3 * * *
CRON_HOURLY=5 * * * *
CRON_METRICS_PORT=9300

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=ridex
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
